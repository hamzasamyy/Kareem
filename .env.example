# Copy this file to ".env" (same folder) and fill in what you need.
# ".env" is your personal secrets file — never commit it or share it.

# Needed when BRAIN = "hosted" in jarvis/config.py (the fast free cloud brain).
# Get a free key from https://console.groq.com (no credit card needed).
# Using OpenRouter or another provider instead? Paste that provider's key here
# and change HOSTED_BASE_URL / HOSTED_MODEL in jarvis/config.py to match.
HOSTED_API_KEY=

# Only needed if you set BRAIN = "claude" in jarvis/config.py.
# Get a key from https://console.anthropic.com/settings/keys
CLAUDE_API_KEY=

# Only needed for the GUC integration (jarvis/guc/) — your single GUC login,
# used to sign in to CMS, the Student Portal, and Mail/OWA. Sessions on these
# systems are short-lived, so Jarvis logs in fresh each check cycle rather
# than reusing a saved session. Never shared with anything except GUC's own
# login pages; never logged, never written to session transcripts.
GUC_USERNAME=
GUC_PASSWORD=
